# 이 파일을 .env.local 로 복사하고 값을 채운다:  cp .env.example .env.local   (.env.local 은 git 에 올라가지 않는다)
# DB 는 Azure SQL(hancyber-lms) 하나만 쓴다 — 내 맥에서 개발할 때도 배포와 같은 Azure DB 에 붙는다.
# 실제 값은 담당자에게 따로 받는다 (newhancyber-db/.env.azure 참고). DB_SERVER 를 비우면 화면은 뜨지만 회원가입·로그인은 「준비 중」 안내가 나온다.

DB_SERVER=hancyber-sql.database.windows.net
DB_PORT=1433
DB_NAME=hancyber-lms
# 사이트 전용 계정 (읽기·쓰기만 됨) — 서버 관리자 계정을 넣지 말 것
DB_USER=hancyber_app
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=false

# 로그인 쿠키 서명 키 — 32자 이상 아무 문자열. 만들기: openssl rand -base64 48
# 홈페이지 · LMS 관리자 · 교강사 사이트는 서로 다른 값을 쓴다 (내 맥에서는 newhancyber-db/.env.azure 의 HOME_SESSION_SECRET).
SESSION_SECRET=
